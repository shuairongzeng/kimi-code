{
  "name": "@zimi-ai/zimi-code-oauth",
  "version": "0.5.0",
  "private": true,
  "description": "Zimi OAuth toolkit for managed Zimi Code authentication",
  "license": "MIT",
  "author": "Zimi AI",
  "homepage": "https://github.com/ZimiAI/zimi-code/tree/main/packages/oauth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZimiAI/zimi-code.git",
    "directory": "packages/oauth"
  },
  "bugs": {
    "url": "https://github.com/ZimiAI/zimi-code/issues"
  },
  "keywords": [
    "zimi",
    "oauth",
    "authentication",
    "auth",
    "cli"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./device": {
      "types": "./src/device.ts",
      "default": "./src/device.ts"
    },
    "./provider-credential": {
      "types": "./src/provider-credential.ts",
      "default": "./src/provider-credential.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
