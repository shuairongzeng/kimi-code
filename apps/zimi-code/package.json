{
  "name": "@zimi-ai/zimi-code",
  "version": "2.5.0",
  "description": "The Starting Point for Next-Gen Agents",
  "license": "MIT",
  "author": "Zimi AI",
  "homepage": "https://github.com/ZimiAI/zimi-code/tree/main/apps/zimi-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZimiAI/zimi-code.git",
    "directory": "apps/zimi-code"
  },
  "bugs": {
    "url": "https://github.com/ZimiAI/zimi-code/issues"
  },
  "keywords": [
    "zimi",
    "zimi-code",
    "cli",
    "agent",
    "coding-agent",
    "ai",
    "tui"
  ],
  "bin": {
    "zimi": "dist/main.mjs"
  },
  "files": [
    "dist",
    "dist-web",
    "native",
    "scripts/postinstall.mjs",
    "scripts/postinstall",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/tui/theme": "./src/tui/theme/index.ts",
    "#/tui/commands": "./src/tui/commands/index.ts",
    "#/cli/sub/web": "./src/cli/sub/web/index.ts",
    "#/cli/sub/web/*": "./src/cli/sub/web/*.ts",
    "#/generated/vis-web-asset": [
      "./src/generated/vis-web-asset.ts",
      "./src/generated/vis-web-asset.d.ts"
    ],
    "#/*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.dist-worker.config.ts && node scripts/copy-native-assets.mjs && node scripts/check-web-assets.mjs",
    "prebuild": "node scripts/build-vis-asset.mjs",
    "catalog:update": "node scripts/update-catalog.mjs --out dist/built-in-catalog.json",
    "smoke": "node scripts/smoke.mjs",
    "build:native:js": "node scripts/native/01-bundle.mjs",
    "build:native:sea": "node scripts/native/build.mjs --profile=local",
    "build:native:release": "node scripts/native/build.mjs --profile=release",
    "package:native": "node scripts/native/package.mjs",
    "produce:native:manifest": "node scripts/native/produce-manifest.mjs",
    "release:native:resolve": "node scripts/native/resolve-release.mjs",
    "test:native:smoke": "node scripts/native/smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:cli-only": "tsx --import ../../build/register-raw-text-loader.mjs ./src/main.ts",
    "dev:server": "ZIMI_CODE_DEV_SERVER=1 tsx --tsconfig ./tsconfig.dev.json --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:kap-server": "ZIMI_CODE_DEV_SERVER=1 tsx --tsconfig ./tsconfig.dev.json --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:kap-server:multi": "ZIMI_CODE_DEV_SERVER=1 tsx --tsconfig ./tsconfig.dev.json --import ../../build/register-raw-text-loader.mjs ./src/main.ts web --no-open --debug-endpoints",
    "dev:server:restart": "node scripts/dev-server-restart.mjs",
    "dev:prod": "node dist/main.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w run build:packages && vitest run",
    "e2e": "pnpm -w run build:packages && ZIMI_E2E=1 vitest run test/e2e",
    "e2e:real": "pnpm -w run build:packages && ZIMI_E2E_REAL=1 vitest run test/e2e/real-llm-smoke.e2e.test.ts",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "^0.3.9"
  },
  "devDependencies": {
    "@zimi-ai/acp-server": "workspace:^",
    "@zimi-ai/agent-core-v2": "workspace:^",
    "@zimi-ai/kap-server": "workspace:^",
    "@zimi-ai/zimi-code-oauth": "workspace:^",
    "@zimi-ai/zimi-code-product": "workspace:^",
    "@zimi-ai/zimi-code-sdk": "workspace:^",
    "@zimi-ai/zimi-telemetry": "workspace:^",
    "@zimi-ai/migration-legacy": "workspace:^",
    "@zimi-ai/minidb": "workspace:^",
    "@zimi-ai/pi-tui": "workspace:^",
    "@zimi-ai/remote-control": "workspace:^",
    "@zimi-ai/session-import": "workspace:^",
    "@zimi-ai/vis-server": "workspace:^",
    "@zimi-ai/vis-web": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.0",
    "@types/yazl": "^2.4.6",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "jimp": "^1.6.1",
    "lovely-mermaid": "0.3.3",
    "pathe": "^2.0.3",
    "postject": "1.0.0-alpha.6",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1",
    "tsx": "^4.21.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
