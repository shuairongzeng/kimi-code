{
  "name": "@zimi-ai/zimi-desktop",
  "version": "2.5.0",
  "private": true,
  "description": "Electron shell that embeds the zimi web server and UI as a desktop app",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && electron .",
